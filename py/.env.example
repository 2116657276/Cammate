# 首次配置时复制为 py/.env.local；已有配置只补缺项，不覆盖真实 Key。
# 此模板不含真实凭据。进程环境变量优先于 .env.local，修改后重启 API/worker。

# 看图与构图：DeepSeek 官方 Flash，支持原生图片输入。
AI_PROVIDER=external
ARK_API_KEY=
ARK_MODEL=deepseek-flash
ARK_API_URL=https://api.deepseek.com/chat/completions
ARK_CHAT_API_URL=https://api.deepseek.com/chat/completions
ARK_REASONING_EFFORT=none
ARK_STRICT_CLOUD=true

# 图片编辑/生成需独立服务；不要把 DeepSeek 看图 Key 填到其他厂商接口。
# URL 默认对应现有图片编辑 provider，MODEL 填该服务实际开通的模型。
ARK_IMAGE_API_KEY=
ARK_IMAGE_MODEL=
ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 融合可选 COMMUNITY_IMAGE_API_KEY/MODEL/API_URL，未设置时沿用 ARK_IMAGE_*。

# 仅在确有自定义场景权重时启用，否则使用仓库默认场景模型。
# SCENE_YOLO_CUSTOM_MODEL=./models/best.pt

CREATIVE_QUEUE_BACKEND=redis
CREATIVE_REDIS_URL=redis://127.0.0.1:6379/0
CREATIVE_REDIS_WORKER_PREFIX=cammate:creative:worker:
CREATIVE_EMBEDDED_WORKER=true
CREATIVE_WORKER_HEARTBEAT_TTL_SEC=15
COMMUNITY_CREATIVE_PROVIDER_TIMEOUT_SEC=75

COMMUNITY_CREATIVE_RETRY_MAX_DELAY_SEC=120
COMMUNITY_CREATIVE_RETRY_JITTER_RATIO=0.35
COMMUNITY_CREATIVE_RESULT_TTL_SEC=604800

CREATIVE_STORAGE_PROVIDER=local
CREATIVE_STORAGE_ENDPOINT=http://127.0.0.1:9000
CREATIVE_STORAGE_BUCKET=cammate-creative
CREATIVE_STORAGE_ACCESS_KEY=minioadmin
CREATIVE_STORAGE_SECRET_KEY=minioadmin
CREATIVE_STORAGE_REGION=us-east-1
CREATIVE_STORAGE_PREFIX=creative-results

COMMUNITY_POSE_MODEL=./models/yolo11n-pose.pt
COMMUNITY_ADMIN_TOKEN=change-me
